generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  SUPERADMIN
  BUSINESS
}

enum JobStatus {
  ACTIVE
  CLOSED
  ARCHIVED
}

enum SubmissionSource {
  WEB
  EMAIL
  DRIVE
}

enum SubmissionStatus {
  RECEIVED
  QUEUED
  EXTRACTING
  EVALUATING
  DONE
  FAILED
}

enum ExtractionMethod {
  TEXT
  VISION
}

enum Verdict {
  PASS
  MAYBE
  FAIL
}

// Single row, id is always 1.
model Settings {
  id                    Int       @id @default(1)
  defaultRetentionDays  Int       @default(180)
  minRetentionDays      Int       @default(180)
  maxRetentionDays      Int       @default(365)
  maxFileSizeMb         Int       @default(10)
  evalModel             String
  // The model that reads a job post into the job form.
  importModel           String    @default("claude-haiku-4-5-20251001")
  // Imports per business in 24 hours.
  importDailyLimit      Int       @default(30)
  lastPurgeAt           DateTime?
  emailIntakeEnabled    Boolean   @default(false)
  // Mail received before this is never picked up.
  emailIntakeSince      DateTime?
  driveIntakeEnabled    Boolean   @default(false)
  // The "Resume Screener" folder in the system account's Drive.
  driveRootFolderId     String?
  // Where the next read of Drive changes starts.
  driveChangesPageToken String?
  // Heartbeat: when the worker was last alive and last finished each poll.
  workerSeenAt          DateTime?
  lastMailPollAt        DateTime?
  lastDrivePollAt       DateTime?
  driveLastAuditAt      DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Business {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  isActive         Boolean  @default(true)
  // null = use Settings default
  retentionDays    Int?
  // null = unlimited
  monthlyEvalLimit Int?
  // null = unlimited
  storageLimitMb   Int?
  driveFolderId    String?
  // Set when the allowed senders change. The worker then updates the folder's sharing.
  driveSyncNeeded  Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users          User[]
  jobs           Job[]
  allowedSenders AllowedSender[]
  submissions    Submission[]
}

model User {
  // Same id as the Supabase auth user.
  id          String    @id @db.Uuid
  email       String    @unique
  name        String?
  role        UserRole
  // null for SUPERADMIN
  businessId  String?
  business    Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdJobs Job[]
}

model AllowedSender {
  id                String   @id @default(cuid())
  businessId        String
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // "email" or "domain"
  kind              String
  // Normalized. Matching is done on this.
  value             String
  // As typed.
  display           String
  createdById       String
  // "shared", "needs_google_account" or "error". null = not shared (yet).
  driveStatus       String?
  drivePermissionId String?
  driveError        String?
  createdAt         DateTime @default(now())

  @@unique([businessId, kind, value])
}

model Skill {
  id        String   @id @default(cuid())
  name      String   @unique
  category  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs JobSkill[]
}

model Job {
  id                    String    @id @default(cuid())
  businessId            String
  business              Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdById           String    @db.Uuid
  createdBy             User      @relation(fields: [createdById], references: [id], onDelete: Restrict)
  title                 String
  roleOverview          String    @db.Text
  requirements          String    @db.Text
  idealCandidateProfile String    @db.Text
  passingCriteria       String    @db.Text
  postUrl               String?
  postSnapshot          String?   @db.Text
  postFetchedAt         DateTime?
  status                JobStatus @default(ACTIVE)
  // Short random code, generated in the app.
  emailAlias            String    @unique
  driveFolderId         String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  skills      JobSkill[]
  submissions Submission[]

  @@index([businessId, status])
}

model JobSkill {
  jobId      String
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skillId    String
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Restrict)
  isRequired Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@id([jobId, skillId])
}

model Submission {
  id                  String            @id @default(cuid())
  jobId               String
  job                 Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  businessId          String
  business            Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  source              SubmissionSource
  status              SubmissionStatus  @default(RECEIVED)
  originalFilename    String
  storageKey          String?
  sha256              String
  fileSizeBytes       Int
  senderEmail         String?
  emailMessageId      String?
  driveFileId         String?
  // The InboundEmail this file arrived with. No foreign key.
  inboundEmailId      String?
  extractedText       String?           @db.Text
  extractionMethod    ExtractionMethod?
  // Counts and flags about the extraction. No resume content.
  extractionMeta      Json?
  // null = not assessed, [] = clean
  hiddenTextFlagsJson Json?
  // True when the extractor removed hidden text. Kept as a column so lists can filter on it.
  hasHiddenText       Boolean           @default(false)
  error               String?           @db.Text
  attempts            Int               @default(0)
  // Queue fields, used by the worker.
  availableAt         DateTime          @default(now())
  lockedUntil         DateTime?
  lockedBy            String?
  receivedAt          DateTime          @default(now())
  completedAt         DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  evaluation Evaluation?

  @@index([jobId, sha256])
  @@index([jobId, receivedAt])
  @@index([businessId, receivedAt])
  @@index([driveFileId])
  @@index([inboundEmailId])
  @@index([status, availableAt])
}

model Evaluation {
  id                       String     @id @default(cuid())
  submissionId             String     @unique
  submission               Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  verdict                  Verdict
  score                    Int
  summary                  String     @db.Text
  resultJson               Json
  manipulationAttemptsJson Json?
  // The job as the model saw it, so later job edits do not change old results.
  jobSnapshotJson          Json
  candidateName            String?
  candidateEmail           String?
  candidatePhone           String?
  // False when the resume was read from page images and quotes could not be checked.
  evidenceVerified         Boolean
  // The resume tried to instruct the screener. verdict and score then hold
  // FAIL and 0, and the two fields below hold what the model gave.
  rejectedForManipulation  Boolean    @default(false)
  preRejectionScore        Int?
  preRejectionVerdict      Verdict?
  model                    String
  promptVersion            String
  inputTokens              Int
  outputTokens             Int
  cacheCreationTokens      Int        @default(0)
  cacheReadTokens          Int        @default(0)
  durationMs               Int
  resultPdfKey             String?
  // The copy of the result PDF in the job's Drive folder. null = not written yet.
  resultDriveFileId        String?
  driveWriteAttempts       Int        @default(0)
  createdAt                DateTime   @default(now())
}

// No foreign keys so rows survive a purge.
model UsageRecord {
  id                  String            @id @default(cuid())
  businessId          String
  // "evaluation" or "job_import"
  kind                String            @default("evaluation")
  // null for job_import rows
  jobId               String?
  source              SubmissionSource?
  model               String
  inputTokens         Int
  outputTokens        Int
  cacheCreationTokens Int               @default(0)
  cacheReadTokens     Int               @default(0)
  durationMs          Int               @default(0)
  // False when the API was called but the evaluation was not saved.
  succeeded           Boolean           @default(true)
  verdict             Verdict?
  fileSizeBytes       Int
  createdAt           DateTime          @default(now())

  @@index([businessId, createdAt])
}

model EventLog {
  id         String   @id @default(cuid())
  businessId String?
  jobId      String?
  type       String
  message    String   @db.Text
  metaJson   Json?
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([type, createdAt])
}

// Single row, id is always "system". The mailbox and Drive the app reads from.
model GoogleConnection {
  id                    String    @id @default("system")
  email                 String
  encryptedRefreshToken String    @db.Text
  // Space separated, as Google returns them.
  scopes                String    @db.Text
  // "ok" or "error"
  status                String
  lastError             String?   @db.Text
  connectedAt           DateTime
  connectedById         String
  lastUsedAt            DateTime?
  updatedAt             DateTime  @updatedAt
}

// One row per message seen in the system mailbox. Inserting the row is the claim.
model InboundEmail {
  id              String    @id @default(cuid())
  gmailMessageId  String    @unique
  threadId        String
  rfcMessageId    String?
  fromAddress     String?
  subject         String?
  receivedAt      DateTime
  businessId      String?
  jobId           String?
  // "processing", "accepted", "rejected", "ignored" or "error"
  status          String
  reason          String?
  // Parsed sender check results. No full headers.
  authSummaryJson Json?
  pdfCount        Int       @default(0)
  acceptedCount   Int       @default(0)
  skippedJson     Json?
  // Only verified, allowed senders get a reply.
  replyWanted     Boolean   @default(false)
  replyAttempts   Int       @default(0)
  replySentAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([businessId, createdAt])
  @@index([status, replySentAt])
}

// One row per file seen in a job's Drive folder. Inserting the row is the claim.
model DriveIntakeItem {
  id              String   @id @default(cuid())
  driveFileId     String   @unique
  jobId           String
  businessId      String
  fileName        String
  uploaderEmail   String?
  // "processing", "accepted", "skipped" or "error"
  status          String
  reason          String?
  submissionId    String?
  // The _SKIPPED.txt or _FAILED.txt written next to the file.
  noteDriveFileId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([businessId, createdAt])
}

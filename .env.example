NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DIRECT_URL=
ANTHROPIC_API_KEY=
APP_BASE_URL=

# Google account the app reads mail and Drive from.
# Redirect URI to register: APP_BASE_URL + /api/admin/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64. node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_SYSTEM_ACCOUNT=

# Worker only. All optional, these are the defaults.
WORKER_CONCURRENCY=3
WORKER_POLL_MS=2000
WORKER_LEASE_SECONDS=300
WORKER_STUB_DELAY_MS=1500

{
  "name": "resume-screener",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "create-superadmin": "tsx --conditions=react-server --env-file=.env scripts/create-superadmin.ts",
    "worker": "tsx --conditions=react-server --env-file=.env src/worker/index.ts",
    "worker:dev": "tsx watch --conditions=react-server --env-file=.env src/worker/index.ts",
    "enqueue-test": "tsx --conditions=react-server --env-file=.env scripts/enqueue-test.ts",
    "make-fixtures": "tsx scripts/make-fixtures.ts",
    "make-test-jobs": "tsx --conditions=react-server --env-file=.env scripts/make-test-jobs.ts",
    "upload-test": "tsx --conditions=react-server --env-file=.env scripts/upload-test.ts",
    "show-extraction": "tsx --conditions=react-server --env-file=.env scripts/show-extraction.ts",
    "purge": "tsx --conditions=react-server --env-file=.env scripts/purge.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@prisma/client": "^6.19.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "googleapis": "^183.0.0",
    "lucide-react": "^1.49.0",
    "next": "15.5.27",
    "next-themes": "^0.4.6",
    "pdf-parse": "2.4.5",
    "pdfkit": "^0.20.2",
    "radix-ui": "^1.6.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
